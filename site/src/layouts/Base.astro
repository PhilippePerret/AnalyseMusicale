---
import '@fontsource/quicksand/latin-400.css';
import '@fontsource/quicksand/latin-700.css';
import '../styles/global.css';
import type { ObjetContact } from '../lib/site';

interface Props {
  title: string;          // Titre de l'onglet
  heading?: string;       // Grand titre vert en tête de page
  bande?: string;         // Texte de la bande grise (HTML autorisé)
  description?: string;
  objetContact?: ObjetContact;
  piedDePage?: boolean;   // false : pas de liens en bas de page (accueil)
  indexer?: boolean;      // false : page exclue des moteurs de recherche
}

const { title, heading, bande, description, objetContact = 'renseignements', piedDePage = true, indexer = true } = Astro.props;
const fullTitle = title === 'Cours d’Analyse Musicale' ? title : `${title} — CAMI`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description}>}
  {!indexer && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <link rel="icon" href="/logo-carres-lettres-portee-200.jpg">
</head>
<body>
  <header class="site">
    <a class="logo" href="/">
      <span class="marque">
        <img src="/logo-carres-lettres-portee-200.jpg" width="80" height="56" alt="Logo CAMI">
        <span>CAMI</span>
      </span>
      <span class="accueil">ACCUEIL</span>
    </a>
    {Astro.url.pathname !== '/' && (
      <div class="nom">Cours d’Analyse Mus<span style="color:ardoise;font-size:1.2em;">i</span>cale</div>
    )}
  </header>

  <main>
    {heading && <h1 class="row titre-page">{heading}</h1>}
    {bande && <div class="row bande-grise" set:html={bande} />}
    <slot />
  </main>

  {piedDePage && (
  <footer class="row site">
    <nav>
      <a href="/">Accueil</a><span> — </span>
      <a href="/cours/">Les cours d’analyse</a><span> — </span>
      <a href="/jeudis-analyse/">Les jeudis de l’analyse</a><span> — </span>
      <a href="/pedagogue/">Philippe Perret, pédagogue</a><span> — </span>
      <a href={`/contact/?objet=${objetContact}`}>Contact</a>
    </nav>
  </footer>
  )}

  <div class="bandeau-cookies" id="bandeauCookies" role="dialog" aria-label="Cookies" hidden>
    <p>Ce site utilise des cookies pour vous garder connecté·e et mémoriser vos choix. Aucun cookie publicitaire. <a href="/confidentialite/#_cookies">En savoir plus</a></p>
    <div class="boutons">
      <button type="button" class="bouton" data-choix="refuse">Refuser</button>
      <button type="button" class="bouton" data-choix="accepte">Accepter</button>
    </div>
  </div>

  <script is:inline>
    // Consentement aux cookies : choix gardé 6 mois dans le cookie « cami-cookies » (accepte | refuse).
    // Tout service soumis à consentement doit tester window.camiCookies.accepte()
    // et écouter l'évènement « cami-cookies » (choix modifié).
    (function () {
      var NOM = 'cami-cookies';
      var bandeau = document.getElementById('bandeauCookies');
      function choix() {
        var m = document.cookie.match(/(?:^|; )cami-cookies=(accepte|refuse)/);
        return m ? m[1] : null;
      }
      function enregistrer(valeur) {
        document.cookie = NOM + '=' + valeur + '; max-age=' + 60 * 60 * 24 * 182 + '; path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
        bandeau.hidden = true;
        document.dispatchEvent(new CustomEvent('cami-cookies', { detail: valeur }));
      }
      window.camiCookies = {
        accepte: function () { return choix() === 'accepte'; },
        ouvrir: function () { bandeau.hidden = false; },
      };
      bandeau.querySelectorAll('[data-choix]').forEach(function (b) {
        b.addEventListener('click', function () { enregistrer(b.dataset.choix); });
      });
      // Liens « modifier votre choix » (page Confidentialité)
      document.querySelectorAll('[data-gerer-cookies]').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); window.camiCookies.ouvrir(); });
      });
      if (!choix()) bandeau.hidden = false;
    })();
  </script>
</body>
</html>
