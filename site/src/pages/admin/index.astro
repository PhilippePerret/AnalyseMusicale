---
// Administration : adresses connues du site (inscrits, téléchargements de la Table d'analyse,
// saisies à la main). Données et actions : /api/personnes.php, par src/scripts/admin.js.
import Base from '../../layouts/Base.astro';
import '../../styles/admin.css';
import { getCollection } from 'astro:content';
import { LIENS_ADMIN } from '../../lib/site';

// Pages publiques du site (menu « Copier l’adresse d’une page… » de la boîte Inviter) :
// libellé = titre de la page, valeur = adresse absolue
const SITE = Astro.site!.href.replace(/\/$/, '');
const EXCLUES = /^\/(admin(\/annonces)?|404|contact\/(merci|erreur)|cours\/(admin|student))\/$/;
const pagesAdoc = await getCollection('pages');
const titreAdoc = (id: string) => pagesAdoc.find((p) => p.id === id)?.data.title;
const pagesAstro = Object.entries(import.meta.glob('../**/*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>)
  .filter(([f]) => !f.includes('['))
  .map(([f, source]) => {
    const chemin = f.replace(/^\.\.\//, '/').replace(/(index)?\.astro$/, '').replace(/([^/])$/, '$1/');
    const titre = source.match(/<Base\b[^>]*?\btitle="([^"]+)"/)?.[1] ?? titreAdoc(chemin === '/' ? 'accueil' : chemin.slice(1, -1));
    return { chemin, titre };
  });
const pagesContenu = pagesAdoc
  .filter((p) => !['accueil', 'table-analyse'].includes(p.id))
  .map((p) => ({ chemin: `/${p.id}/`, titre: p.data.title }));
const pagesSite = [...pagesAstro, ...pagesContenu]
  .filter((p) => !EXCLUES.test(p.chemin))
  .map((p) => ({ url: SITE + p.chemin, titre: p.titre ?? p.chemin }))
  .sort((x, y) => x.titre.localeCompare(y.titre, 'fr'));
---
<Base title="Adresses" indexer={false} liensAdmin={LIENS_ADMIN.filter(([href]) => href !== '/admin/')}>
  <div class="row admin">
    <h1 class="titre-page">Adresses</h1>

    <p class="acces" id="acces" hidden>Page réservée à l’administrateur : <a href="/jeudis-analyse/?compte=connexion&retour=/admin/">s’identifier</a>.</p>

    <div id="contenu" hidden>
      <div class="barre">
        <label>Afficher
          <select id="filtre">
            <option value="">toutes les adresses</option>
            <option value="telechargement">téléchargements de la Table d’analyse</option>
            <option value="inscrit">inscrits</option>
            <option value="main">saisies à la main</option>
            <option value="contact">emails seuls</option>
          </select>
        </label>
        <span class="compte" id="compte"></span>
        <button type="button" class="bouton inviter" id="ouvrirInvitation">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a7 7 0 0 1 14 0v2"/><path d="M19 8v6M16 11h6"/></svg>
          Inviter…
        </button>
      </div>

      <table class="adresses">
        <thead>
          <tr>
            <th class="case"><input type="checkbox" id="toutes" title="Tout sélectionner"></th>
            <th>Adresse</th>
            <th>Origine</th>
            <th>Détail</th>
          </tr>
        </thead>
        <tbody id="lignes"></tbody>
      </table>
      <p class="legende-tba">La mention TbA indique que l’utilisateur/trice a téléchargé l’application <em>Table d’analyse</em>.</p>

      <div class="actions">
        <button type="button" class="bouton" id="ouvrirMessage" disabled>Écrire à la sélection…</button>
        <button type="button" class="bouton supprimer" id="ouvrirSuppression" disabled>Supprimer la sélection…</button>
      </div>

      <form class="panneau" id="formMessage" hidden>
        <h3>Message à <span class="nombre"></span></h3>
        <label class="en-regard">Objet <input type="text" name="objet" required maxlength="200"></label>
        <label class="en-regard haut">Message <textarea name="message" required rows="8"></textarea></label>
        <label class="en-regard">Pièce jointe <input type="file" name="piece"></label>
        <p class="message" hidden></p>
        <div class="boutons">
          <button type="button" class="bouton annuler">Annuler</button>
          <button class="bouton">Envoyer</button>
        </div>
      </form>

      <dialog class="panneau invitation" id="dialogInvitation">
        <form id="formInvitation">
          <div class="entete">
            <h3>Inviter</h3>
            <label>Invitation
              <select id="choixInvitation"><option value="">nouvelle invitation</option></select>
            </label>
            <span class="suppression">
              <button type="button" class="lien-supprimer" id="supprimerInvitation" hidden>Supprimer cette invitation…</button>
              <button type="button" class="bouton confirmer" id="confirmerSuppressionInvitation" hidden>Confirmer la suppression</button>
            </span>
            <span class="programmation">
              <button type="button" class="bouton" id="programmerInvitation">Programmer l’envoi le</button>
              <input type="date" name="date" aria-label="Date d’envoi">
              <label>à <input type="time" name="heure" step="300"></label>
            </span>
          </div>
          <span class="etat" id="etatInvitation"></span>
          <div class="colonnes">
            <div class="redaction">
              <label class="en-regard">Objet <input type="text" name="objet" required maxlength="200"></label>
              <label class="en-regard haut">Message <textarea name="message" required rows="14"></textarea></label>
            </div>
            <div class="colonne-adresses">
              <label class="adresses"><span>Adresses <span class="aide">(adresse H ou F)</span></span> <textarea name="adresses" placeholder="une personne par ligne :
adresse H
adresse F"></textarea></label>
              <div class="invites" id="invitesInvitation" hidden>
                <span class="titre"></span>
                <ul></ul>
              </div>
            </div>
          </div>
          <p class="message" hidden></p>
          <div class="boutons colonnes">
            <span class="gauche">
              <button type="button" class="bouton annuler">Fermer</button>
              <select id="copierUrl">
                <option value="">Copier l’adresse d’une page…</option>
                {pagesSite.map((p) => <option value={p.url}>{p.titre}</option>)}
              </select>
              <button type="button" class="bouton" id="enregistrerInvitation">Enregistrer</button>
            </span>
            <span class="envois">
              <button class="bouton">Envoyer maintenant</button>
            </span>
          </div>
        </form>
      </dialog>

      <div class="panneau danger" id="panneauSuppression" hidden>
        <h3>Supprimer définitivement <span class="nombre"></span></h3>
        <p class="liste"></p>
        <p class="message" hidden></p>
        <div class="boutons">
          <button type="button" class="bouton confirmer">Supprimer définitivement</button>
          <button type="button" class="bouton annuler">Annuler</button>
        </div>
      </div>

      <h2 class="rubrique-admin">Ajouter une adresse</h2>
      <form class="panneau ajout" id="formAjout">
        <label class="en-regard">Enregistrer comme…
          <select name="comme">
            <option value="telechargement">téléchargement</option>
            <option value="inscrit">inscrit</option>
            <option value="contact">email seul</option>
          </select>
        </label>
        <label class="en-regard">Adresse e-mail <input type="email" name="email" required maxlength="200"></label>
        <fieldset data-comme="telechargement">
          <div class="une-ligne">
            <label>Plateforme
              <select name="systeme">
                <option>macOS</option>
                <option>Windows</option>
                <option>Linux</option>
              </select>
            </label>
            <label>Version <input type="text" name="version" class="version" pattern="\d+(\.\d+){0,3}" placeholder="2.1.6"></label>
            <label>Téléchargé le <input type="date" name="date"></label>
          </div>
        </fieldset>
        <fieldset data-comme="inscrit contact" hidden>
          <div class="une-ligne">
            <label>Pseudo <input type="text" name="pseudo" maxlength="60"></label>
            <label>Le site doit s’adresser à vous en tant que…
              <select name="genre">
                <option value="">—</option>
                <option value="F">une femme</option>
                <option value="H">un homme</option>
                <option value="N">non précisé (un homme)</option>
              </select>
            </label>
          </div>
        </fieldset>
        <fieldset data-comme="inscrit" hidden>
          <div class="une-ligne">
            <label><input type="checkbox" name="avertir" checked> à avertir des prochains jeudis</label>
            <label><input type="checkbox" name="auditeur"> auditeur ou auditrice libre</label>
          </div>
        </fieldset>
        <p class="message" hidden></p>
        <div class="boutons">
          <span></span>
          <button class="bouton">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>

  <script src="../../scripts/admin.js"></script>
</Base>
