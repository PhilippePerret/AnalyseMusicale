---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { TABLE_ANALYSE } from '../lib/site';

// Fichier local (public/) absent : non proposé
const disponible = (chemin: string) => !chemin.startsWith('/') || existsSync(join(process.cwd(), 'public', chemin));
const telechargements = TABLE_ANALYSE.telechargements.filter((t) => disponible(t.fichier));
const demo = disponible(TABLE_ANALYSE.demo) ? TABLE_ANALYSE.demo : null;
---
<Base
  title="Table d’analyse"
  heading="La Table d’analyse"
  bande="L’application pour analyser une partition directement sur ses systèmes : accords, harmonie, cadences, forme…"
  description="Télécharger la Table d’analyse de Philippe Perret, application d’analyse musicale pour macOS, Windows et Linux."
>
  <div class="row colonne">
    <h2>Démonstration</h2>
    {demo
      ? <video class="demo" src={demo} controls preload="metadata"></video>
      : <p class="demo-absente">La vidéo de démonstration sera bientôt disponible.</p>}

    <h2>Télécharger l’application</h2>
    <form class="contact-form" id="telechargement" method="post" action="/telechargement.php">
      <label>Indiquez votre adresse mail pour télécharger l’application
        <input type="email" name="email" required maxlength="200" autocomplete="email">
      </label>
      <div class="piege" aria-hidden="true">
        <label>Ne pas remplir ce champ
          <input type="text" name="site_web" tabindex="-1" autocomplete="off">
        </label>
      </div>
      <button type="submit">Obtenir les liens</button>
      <p class="message" hidden></p>
    </form>

    <div id="liens" hidden>
      <p>Merci ! Choisissez la version pour votre système (version {TABLE_ANALYSE.version}) :</p>
      <ul class="telechargements">
        {telechargements.map((t) => (
          <li><a data-href={t.fichier} download>{t.systeme}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <script is:inline>
    // Adresse envoyée à /telechargement.php, puis liens affichés
    (function () {
      var form = document.getElementById('telechargement');
      var message = form.querySelector('.message');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        message.hidden = true;
        fetch(form.action, { method: 'POST', body: new FormData(form) })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.error || 'erreur');
            document.querySelectorAll('#liens a[data-href]').forEach(function (a) { a.href = a.dataset.href; });
            form.hidden = true;
            document.getElementById('liens').hidden = false;
          })
          .catch(function () {
            message.textContent = 'Cette adresse n’a pas pu être enregistrée. Vérifiez-la et réessayez.';
            message.hidden = false;
          });
      });
    })();
  </script>
</Base>
