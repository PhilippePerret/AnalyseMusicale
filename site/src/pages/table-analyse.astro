---
// Textes : src/content/pages/table-analyse.adoc. Les lignes « @demonstration »
// et « @telechargement » y placent la vidéo et le formulaire ci-dessous.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { TABLE_ANALYSE } from '../lib/site';

const page = await getEntry('pages', 'table-analyse');
if (!page) throw new Error('src/content/pages/table-analyse.adoc introuvable');
const { title, description, bande } = page.data;
// Morceaux de HTML séparés par les marqueurs : [html, 'demonstration', html, 'telechargement', html]
const morceaux = (page.rendered?.html ?? '').split(/<div class="paragraph">\s*<p>@(demonstration|telechargement)<\/p>\s*<\/div>/);

// Fichier local (public/) absent : non proposé
const disponible = (chemin: string) => !chemin.startsWith('/') || existsSync(join(process.cwd(), 'public', chemin));
const telechargements = TABLE_ANALYSE.telechargements.filter((t) => disponible(t.fichier));
const demo = disponible(TABLE_ANALYSE.demo) ? TABLE_ANALYSE.demo : null;
---
<Base title={title} heading={title} bande={bande} description={description}>
  <div class="row colonne adoc">
  {morceaux.map((m, i) => i % 2 === 0 ? <Fragment set:html={m} /> : m === 'demonstration' ? (
    demo
      ? <video class="demo" src={demo} controls preload="metadata"></video>
      : <p class="demo-absente">La vidéo de démonstration sera bientôt disponible.</p>
  ) : (
    <>
    <form class="contact-form" id="telechargement" method="post" action="/telechargement.php">
      <p class="version-courante">Version courante : <strong class="version-table">{TABLE_ANALYSE.version}</strong></p>
      <p class="consigne" id="consigneMail">Pour obtenir le lien de téléchargement de l’application, merci d’indiquer votre adresse mail (ou de <a href="/jeudis-analyse/?compte=connexion&retour=/table-analyse/">vous connecter</a>/<a href="/jeudis-analyse/?compte=inscription&retour=/table-analyse/">vous inscrire</a>)</p>
      <label class="cgu"><input type="checkbox" name="cgu" required> <span>J’accepte les <a href="/cgu/" target="_blank">conditions générales d’utilisation</a></span></label>
      <div class="ligne-envoi">
        <input type="email" name="email" required maxlength="200" autocomplete="email" placeholder="adresse mail" aria-labelledby="consigneMail">
        <label>Plateforme
          <select name="fichier" required>
            <option value="">—</option>
            {TABLE_ANALYSE.telechargements.map((t) => <option value={t.fichier} data-systeme={t.systeme}>{t.systeme}</option>)}
          </select>
        </label>
        <button type="submit">Obtenir le lien de téléchargement</button>
      </div>
      <div class="piege" aria-hidden="true">
        <label>Ne pas remplir ce champ
          <input type="text" name="site_web" tabindex="-1" autocomplete="off">
        </label>
      </div>
      <p class="message" hidden></p>
    </form>

    <div id="liens" hidden>
      <p><span id="merci">Merci ! </span>Choisissez la version pour votre système (version <span class="version-table">{TABLE_ANALYSE.version}</span>) :</p>
      <ul class="telechargements">
        {telechargements.map((t) => (
          <li><a data-href={t.fichier} data-systeme={t.systeme}>{t.systeme}</a></li>
        ))}
      </ul>
    </div>

    <div id="deblocageMac" class="deblocage-mac" hidden>
      <p>Pour débloquer l’application, jouer ce code dans votre application Terminal</p>
      <div class="terminal-copie">
        <pre class="terminal"><code>{TABLE_ANALYSE.deblocageMac}</code></pre>
        <button type="button" class="copier" id="copierDeblocage" title="Copier le code" aria-label="Copier le code">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
        <span class="copie-ok" id="copieOk" hidden>Copié</span>
      </div>
    </div>
    </>
  ))}
  </div>

  <script is:inline>
    // Dernière version publiée (Release GitHub de l'application) : numéro affiché
    // et liens de téléchargement mis à jour. Sans réponse : valeurs du site gardées.
    (function () {
      var EXTENSIONS = { macOS: /\.dmg$/, Windows: /\.exe$/, Linux: /\.AppImage$/ };
      fetch('https://api.github.com/repos/PhilippePerret/TableAnalyse-nodejs/releases/latest')
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (rel) {
          var version = String(rel.tag_name || '').replace(/^v/, '');
          if (!version) return;
          document.querySelectorAll('.version-table').forEach(function (e) { e.textContent = version; });
          document.querySelectorAll('[data-systeme]').forEach(function (e) {
            var motif = EXTENSIONS[e.dataset.systeme];
            var fichier = (rel.assets || []).find(function (a) { return motif && motif.test(a.name); });
            if (!fichier) return;
            if (e.tagName === 'OPTION') e.value = fichier.browser_download_url;
            else e.dataset.href = fichier.browser_download_url;
          });
        })
        .catch(function () {});
    })();

    // Visiteur identifié : liens affichés directement.
    // Sinon : adresse + plateforme envoyées à /telechargement.php, qui envoie le lien par mail.
    (function () {
      var form = document.getElementById('telechargement');
      var message = form.querySelector('.message');
      // Liens par /api/telecharger.php : téléchargement enregistré (fichier lu au clic, après mise à jour de la version)
      function afficherLiens() {
        document.querySelectorAll('#liens a[data-href]').forEach(function (a) {
          function lien() { return '/api/telecharger.php?fichier=' + encodeURIComponent(a.dataset.href) + '&systeme=' + encodeURIComponent(a.dataset.systeme); }
          a.href = lien();
          a.addEventListener('click', function () { a.href = lien(); });
        });
        form.hidden = true;
        document.getElementById('liens').hidden = false;
      }
      // Plateforme macOS choisie : commande de déblocage affichée
      var deblocage = document.getElementById('deblocageMac');
      form.elements.fichier.addEventListener('change', function () {
        var choix = this.options[this.selectedIndex];
        deblocage.hidden = choix.dataset.systeme !== 'macOS';
      });
      // Picto : code de déblocage copié dans le presse-papier
      document.getElementById('copierDeblocage').addEventListener('click', function () {
        var ok = document.getElementById('copieOk');
        navigator.clipboard.writeText(deblocage.querySelector('code').textContent).then(function () {
          ok.hidden = false;
          setTimeout(function () { ok.hidden = true; }, 1800);
        });
      });
      document.querySelectorAll('#liens a[data-systeme="macOS"]').forEach(function (a) {
        a.addEventListener('click', function () { deblocage.hidden = false; });
      });
      fetch('/api/moi.php', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (res) { if (res.user) { document.getElementById('merci').hidden = true; afficherLiens(); } })
        .catch(function () {});
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        message.hidden = true;
        var donnees = new FormData(form);
        var choix = form.elements.fichier;
        donnees.append('systeme', choix.options[choix.selectedIndex].text);
        var ERREURS = {
          email: 'Adresse mail invalide. Vérifiez-la et réessayez.',
          plateforme: 'Choisissez votre plateforme.',
          cgu: 'L’acceptation des conditions générales d’utilisation est nécessaire.',
          indisponible: 'Cette version n’est pas encore disponible au téléchargement.',
        };
        fetch(form.action, { method: 'POST', body: donnees })
          .then(function (r) { return r.json(); })
          .then(function (res) {
            if (!res.ok) throw new Error(res.error || 'erreur');
            form.innerHTML = '<p class="envoye">Le lien de téléchargement vient d’être envoyé à <strong></strong>.</p>';
            form.querySelector('strong').textContent = donnees.get('email');
          })
          .catch(function (err) {
            message.textContent = ERREURS[err.message] || 'Le lien n’a pas pu être envoyé. Réessayez dans un moment.';
            message.hidden = false;
          });
      });
    })();
  </script>
</Base>
