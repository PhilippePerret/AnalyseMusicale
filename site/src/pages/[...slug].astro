---
// Pages rédigées en AsciiDoc (src/content/pages/**/*.adoc)
// jeudis-analyse/detail.adoc → /jeudis-analyse/detail/
// (sauf accueil.adoc → index.astro et table-analyse.adoc → table-analyse.astro)
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { LIENS_COURS_ADMIN } from '../lib/site';

export async function getStaticPaths() {
  // Pages .adoc affichées par leur propre page .astro
  const PAGES_SPECIALES = ['accueil', 'table-analyse'];
  const pages = await getCollection('pages');
  return pages.filter((page) => !PAGES_SPECIALES.includes(page.id)).map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, description, bande, objetContact } = page.data;
---
<Base title={title} heading={title} bande={bande} description={description} objetContact={objetContact} liensAdmin={page.id === 'cours' ? [...LIENS_COURS_ADMIN] : undefined}>
  <div class="row">
    <div class="adoc colonne">
      <Content />
    </div>
  </div>
</Base>
