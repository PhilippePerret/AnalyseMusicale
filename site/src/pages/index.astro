---
// Page d'accueil : contenu dans src/content/pages/accueil.adoc
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'accueil');
if (!page) throw new Error('src/content/pages/accueil.adoc introuvable');
const { Content } = await render(page);
const { title, description, bande } = page.data;
---
<Base title={title} heading={title} bande={bande} description={description} piedDePage={false}>
  <div class="row adoc accueil">
    <Content />
  </div>
</Base>
