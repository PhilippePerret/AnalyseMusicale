---
// Gestion des cours (issue #13, administrateur) : demandes de cours, élèves, groupes, lieux mémorisés (disponibilités : mode « Dispos » du calendrier).
// Données et actions : /api/cours.php, par src/scripts/cours-admin.js.
import Base from '../../../layouts/Base.astro';
import '../../../styles/cours.css';
---
<Base title="Gestion des élèves" indexer={false} objetContact="cours">
  <div class="row cours-page cours-admin">
    <h1 class="titre-page">Gestion des élèves</h1>

    <div id="chargement" class="vide">Chargement…</div>
    <p class="acces" id="refus" hidden>Page réservée à l’administrateur : <a href="/cours/student/">s’identifier</a>.</p>

    <div id="contenu" hidden>
      <p class="barre-compte"><a href="/cours/student/">Calendrier des cours</a></p>

      <h2 class="rubrique">Demandes de cours</h2>
      <table class="liste demandes">
        <thead><tr><th>Demandeur</th><th>Reçue le</th><th>Fréquence et créneaux</th><th>Connaissances</th><th></th></tr></thead>
        <tbody id="demandes"></tbody>
      </table>

      <h2 class="rubrique">Élèves</h2>
      <div class="liste-eleves">
        <div class="barre-eleves">
          <input type="search" id="filtreEleves" placeholder="Filtrer (mail, pseudo, genre…)" class="filtre" autocomplete="off">
          <span class="onglets" id="ongletsEleves">
            <label><input type="radio" name="statut" value="actif" checked>actifs</label><label><input type="radio" name="statut" value="inactif">inactifs</label><label><input type="radio" name="statut" value="">tous</label>
          </span>
        </div>
        <ul class="eleves" id="eleves"></ul>
        <div class="barre-eleves" id="actionsEleves">
          <label class="case"><input type="checkbox" id="toutCocher"> tout cocher</label>
          <span class="compte" id="nbCoches"></span>
          <select id="actionEleves">
            <option value="">Action…</option><option value="modifier">Modifier</option><option value="contacter">Contacter</option>
            <option value="inactif">Rendre inactif</option><option value="actif">Rendre actif</option><option value="supprimer">Supprimer…</option>
          </select>
          <button type="button" class="bouton" id="appliquerEleves">Appliquer</button>
          <button type="button" class="confirmer" id="confirmerSuppression" hidden>Confirmer la suppression</button>
          <p class="message" hidden></p>
        </div>

        <h3 class="sous-rubrique" id="titreFormEleve">Nouvel élève</h3>
        <form class="ligne simple" id="formEleve">
          <input type="hidden" name="id" value="0">
          <input type="email" name="email" required maxlength="200" size="20" placeholder="Adresse e-mail" aria-label="Adresse e-mail">
          <input type="text" name="pseudo" maxlength="60" size="12" placeholder="Pseudo" aria-label="Pseudo">
          <label class="en-tant-que">en tant que
            <select name="genre"><option value="F">une femme</option><option value="H">un homme</option><option value="N" selected>non précisé</option></select>
          </label>
          <select name="actif" class="statut-eleve" aria-label="Statut"><option value="1">actif</option><option value="0">inactif</option></select>
          <span class="envoi">
            <label class="case" id="caseBienvenue"><input type="checkbox" name="bienvenue" checked> Mail de bienvenue</label>
            <button type="button" class="bouton annuler" id="annulerEleve" hidden>Annuler</button>
            <button class="bouton" id="boutonEleve">Inscrire</button>
          </span>
          <p class="message" hidden></p>
        </form>
      </div>

      <h2 class="rubrique">Groupes</h2>
      <table class="liste">
        <thead><tr><th>Groupe</th><th>Élèves</th><th>Lieu habituel</th><th></th></tr></thead>
        <tbody id="groupes"></tbody>
      </table>
      <form class="ligne" id="formGroupe">
        <input type="hidden" name="id" value="0">
        <label>Nom <input type="text" name="nom" maxlength="80" size="16"></label>
        <span class="eleves-groupe" id="elevesGroupe"></span>
        <label>Lieu habituel <input type="text" name="lieu" maxlength="300" size="22" placeholder="lien visio ou adresse"></label>
        <button type="button" class="bouton annuler" id="annulerGroupe" hidden>Annuler</button>
        <button class="bouton" id="boutonGroupe">Créer le groupe</button>
        <p class="message" hidden></p>
      </form>

      <h2 class="rubrique">Lieux mémorisés</h2>
      <table class="liste">
        <thead><tr><th>Nom</th><th>Lien visio ou adresse</th><th></th></tr></thead>
        <tbody id="lieux"></tbody>
      </table>
      <form class="ligne" id="formLieu">
        <label>Nom <input type="text" name="nom" required maxlength="60" size="12"></label>
        <label>Lien visio ou adresse <input type="text" name="valeur" required maxlength="300" size="34"></label>
        <button class="bouton">Mémoriser</button>
        <p class="message" hidden></p>
      </form>
    </div>
  </div>

  <script src="../../../scripts/cours-admin.js"></script>
</Base>
